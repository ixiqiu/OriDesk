# ===== 复制为 .env 后填写；.env 永不入库（开发文档 §9.3）=====

# Django
DJANGO_SECRET_KEY=请替换为50位以上随机字符串
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=ticket.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://ticket.example.com
DJANGO_TIME_ZONE=Asia/Shanghai

# 数据库：mysql=MariaDB（生产），sqlite=本地开发/单元测试
DB_ENGINE=mysql
DB_NAME=ticket_system
DB_USER=ticket
DB_PASSWORD=请替换
DB_HOST=db
DB_PORT=3306
DB_ROOT_PASSWORD=请替换

# 邮箱凭据加密密钥（Fernet）。必须独立备份，丢失则所有邮箱凭据需重配。
FERNET_KEY=请用 python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())" 生成

# Redis / RQ
REDIS_URL=redis://redis:6379/0

# IMAP 轮询间隔（秒），可被数据库设置项覆盖
IMAP_POLL_INTERVAL_SECONDS=60

# 反向代理后面开启 HTTPS 相关安全开关
DJANGO_SECURE_SSL_REDIRECT=True

# 附件下发走 Nginx 内部重定向（推荐，配合 deploy/nginx 中 /media/attachments/ 的 internal location）。
# 留空则由 Django 自己流式返回附件。必须与 Nginx 的 location 前缀一致。
ATTACHMENT_X_ACCEL_PREFIX=/media/attachments/

# ===== 可选：编排 / 入口脚本（保持注释即为默认值）=====
# WEB_PORT=8000                  # 宿主 127.0.0.1:<port> → 容器 8000；改了要同步改 Nginx upstream
# HOST_MEDIA_DIR=/srv/ticket-system/media          # 宿主媒体目录（附件落盘）
# HOST_STATIC_DIR=/srv/ticket-system/staticfiles   # 宿主静态目录（collectstatic 产物）
# MEDIA_ROOT=/app/media          # 容器内媒体根目录，与 settings.py 默认一致
# STATIC_ROOT=/app/staticfiles   # 容器内静态根目录，与 settings.py 默认一致
# DB_WAIT_TIMEOUT=60             # 入口脚本等待数据库就绪的上限（秒）
# REDIS_WAIT_TIMEOUT=60          # 入口脚本等待 Redis 就绪的上限（秒）
# SKIP_ENV_CHECK=0               # 设为 1 跳过"示例密钥占位"检查（仅限本地调试）

# ===== 可选：业务参数（也可登录后在"系统设置"里改，两者以界面为准）=====
# MAX_ATTACHMENT_SIZE_MB=25      # 附件大小上限（MB），需 ≤ Nginx client_max_body_size
# IMAP_POLL_INTERVAL_SECONDS=60  # 已在上方列出，此处仅作对照

# ===== 可选：安全加固（生产建议保持默认）=====
# DJANGO_SECURE_HSTS_SECONDS=31536000   # HSTS 有效期；0 表示关闭 HSTS
# DJANGO_SECURE_HSTS_PRELOAD=False      # 提交浏览器 preload 列表后再置 True（难以撤回）

# ===== 可选：备份/恢复脚本（scripts/backup.sh、scripts/restore.sh）=====
# BACKUP_DIR=/srv/ticket-system/backups  # 备份输出目录
# BACKUP_RETENTION_DAYS=14               # 备份保留天数
# BACKUP_INCLUDE_ENV=0                   # 设为 1 会把 .env（含密钥）一并打包，仅当备份目录已加密
# BACKUP_DB_HOST=127.0.0.1               # 仅"非容器化 + 宿主客户端"备份路径使用
# BACKUP_DB_PORT=3306
# SKIP_SAFETY_BACKUP=0                   # 恢复脚本设为 1 可跳过"恢复前现状快照"（不推荐）
